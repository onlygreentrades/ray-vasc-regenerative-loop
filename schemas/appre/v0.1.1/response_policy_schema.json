{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Response Policy Schema",
  "version": "v0.1.1",
  "description": "APPRE v0.1.1 public schema. Documentation architecture only; not validated AI, CDS, SaMD, or treatment optimization.",
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string",
      "description": "Subject ID.",
      "appre_vocabulary_or_range": "pseudonymous identifier",
      "appre_required": true
    },
    "response_policy_id": {
      "type": "string",
      "description": "Policy ID.",
      "appre_vocabulary_or_range": "unique identifier",
      "appre_required": true
    },
    "response_policy_version": {
      "type": "string",
      "description": "Policy version.",
      "appre_vocabulary_or_range": "semantic version",
      "appre_required": true
    },
    "effective_date": {
      "type": "string",
      "description": "Effective date.",
      "appre_vocabulary_or_range": "YYYY-MM-DD or shifted date",
      "appre_required": true
    },
    "phase": {
      "type": "string",
      "description": "Phase.",
      "appre_vocabulary_or_range": "controlled vocabulary",
      "appre_required": true
    },
    "cycle": {
      "type": "string",
      "description": "Cycle.",
      "appre_vocabulary_or_range": "cycle1|cycle2|not_applicable",
      "appre_required": false
    },
    "trigger_event_type": {
      "type": "string",
      "description": "Trigger type.",
      "appre_vocabulary_or_range": "ae|confounder|missingness|candidate_signal|schema_update|release|other",
      "appre_required": true
    },
    "trigger_event_id": {
      "type": "string",
      "description": "Linked event.",
      "appre_vocabulary_or_range": "event ID",
      "appre_required": false
    },
    "policy_domain": {
      "type": "string",
      "description": "Policy domain.",
      "appre_vocabulary_or_range": "measurement|burden|safety|candidate_input|analysis|release|other",
      "appre_required": true
    },
    "prior_policy_summary": {
      "type": "string",
      "description": "Prior posture summary.",
      "appre_vocabulary_or_range": "text",
      "appre_required": false
    },
    "updated_policy_summary": {
      "type": "string",
      "description": "Updated documentation posture.",
      "appre_vocabulary_or_range": "text",
      "appre_required": true
    },
    "rationale": {
      "type": "string",
      "description": "Rationale.",
      "appre_vocabulary_or_range": "text",
      "appre_required": true
    },
    "safety_override_yes_no": {
      "type": "string",
      "description": "Safety override.",
      "appre_vocabulary_or_range": "yes|no",
      "appre_required": false
    },
    "clinician_review_required_yes_no": {
      "type": "string",
      "description": "Clinician review requirement.",
      "appre_vocabulary_or_range": "yes|no",
      "appre_required": false
    },
    "controlled_substance_tuning_involved": {
      "type": "string",
      "description": "Should be no in public APPRE release.",
      "appre_vocabulary_or_range": "must be no",
      "appre_required": true
    },
    "candidate_input_rule_status": {
      "type": "string",
      "description": "Candidate-input status.",
      "appre_vocabulary_or_range": "unchanged|documented_change|paused_by_team|not_applicable",
      "appre_required": false
    },
    "burden_reduction_rule_status": {
      "type": "string",
      "description": "Burden status.",
      "appre_vocabulary_or_range": "active|inactive|not_applicable",
      "appre_required": false
    },
    "missingness_rule_status": {
      "type": "string",
      "description": "Missingness status.",
      "appre_vocabulary_or_range": "clean|partial|missing|uninterpretable",
      "appre_required": false
    },
    "approved_by_role": {
      "type": "string",
      "description": "Approver role.",
      "appre_vocabulary_or_range": "role",
      "appre_required": false
    },
    "created_at": {
      "type": "string",
      "description": "Creation timestamp.",
      "appre_vocabulary_or_range": "ISO 8601",
      "appre_required": true
    },
    "record_status": {
      "type": "string",
      "description": "Record status.",
      "appre_vocabulary_or_range": "draft|reviewed|locked|amended",
      "appre_required": true
    }
  },
  "required": [
    "subject_id",
    "response_policy_id",
    "response_policy_version",
    "effective_date",
    "phase",
    "trigger_event_type",
    "policy_domain",
    "updated_policy_summary",
    "rationale",
    "controlled_substance_tuning_involved",
    "created_at",
    "record_status"
  ]
}
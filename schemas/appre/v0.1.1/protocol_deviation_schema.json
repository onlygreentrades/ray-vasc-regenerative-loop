{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protocol Deviation Schema",
  "version": "v0.1.1",
  "description": "APPRE v0.1.1 public schema. Documentation architecture only; not validated AI, CDS, SaMD, or treatment optimization.",
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string",
      "description": "Subject ID.",
      "appre_vocabulary_or_range": "pseudonymous identifier",
      "appre_required": true
    },
    "deviation_id": {
      "type": "string",
      "description": "Deviation ID.",
      "appre_vocabulary_or_range": "unique identifier",
      "appre_required": true
    },
    "deviation_date": {
      "type": "string",
      "description": "Deviation date.",
      "appre_vocabulary_or_range": "YYYY-MM-DD or shifted date",
      "appre_required": true
    },
    "deviation_category": {
      "type": "string",
      "description": "Category.",
      "appre_vocabulary_or_range": "missed_assessment|timing|procedure|device|assessor|other",
      "appre_required": true
    },
    "expected_procedure": {
      "type": "string",
      "description": "Expected procedure.",
      "appre_vocabulary_or_range": "text",
      "appre_required": false
    },
    "actual_procedure": {
      "type": "string",
      "description": "Actual procedure.",
      "appre_vocabulary_or_range": "text",
      "appre_required": false
    },
    "reason_for_deviation": {
      "type": "string",
      "description": "Reason.",
      "appre_vocabulary_or_range": "text",
      "appre_required": false
    },
    "affected_data_window": {
      "type": "string",
      "description": "Affected window.",
      "appre_vocabulary_or_range": "window ID or dates",
      "appre_required": false
    },
    "major_minor_classification": {
      "type": "string",
      "description": "Classification.",
      "appre_vocabulary_or_range": "major|minor|unknown",
      "appre_required": false
    },
    "corrective_action": {
      "type": "string",
      "description": "Corrective action.",
      "appre_vocabulary_or_range": "text",
      "appre_required": false
    },
    "requires_protocol_amendment_yes_no": {
      "type": "string",
      "description": "Amendment flag.",
      "appre_vocabulary_or_range": "yes|no",
      "appre_required": false
    },
    "reported_by_role": {
      "type": "string",
      "description": "Reported by role.",
      "appre_vocabulary_or_range": "role",
      "appre_required": false
    },
    "reviewed_by_role": {
      "type": "string",
      "description": "Reviewed by role.",
      "appre_vocabulary_or_range": "role",
      "appre_required": false
    },
    "created_at": {
      "type": "string",
      "description": "Creation timestamp.",
      "appre_vocabulary_or_range": "ISO 8601",
      "appre_required": true
    },
    "record_status": {
      "type": "string",
      "description": "Record status.",
      "appre_vocabulary_or_range": "draft|reviewed|locked|amended",
      "appre_required": true
    }
  },
  "required": [
    "subject_id",
    "deviation_id",
    "deviation_date",
    "deviation_category",
    "created_at",
    "record_status"
  ]
}
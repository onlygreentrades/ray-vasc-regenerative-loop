{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Confounder Schema",
  "version": "v0.1.1",
  "description": "APPRE v0.1.1 public schema. Documentation architecture only; not validated AI, CDS, SaMD, or treatment optimization.",
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string",
      "description": "Subject ID.",
      "appre_vocabulary_or_range": "pseudonymous identifier",
      "appre_required": true
    },
    "confounder_id": {
      "type": "string",
      "description": "Confounder ID.",
      "appre_vocabulary_or_range": "unique identifier",
      "appre_required": true
    },
    "confounder_date_start": {
      "type": "string",
      "description": "Start date.",
      "appre_vocabulary_or_range": "YYYY-MM-DD or shifted date",
      "appre_required": true
    },
    "confounder_date_end": {
      "type": "string",
      "description": "End date.",
      "appre_vocabulary_or_range": "YYYY-MM-DD or shifted date",
      "appre_required": false
    },
    "confounder_category": {
      "type": "string",
      "description": "Confounder category.",
      "appre_vocabulary_or_range": "controlled vocabulary",
      "appre_required": true
    },
    "confounder_description": {
      "type": "string",
      "description": "Structured description; avoid direct identifiers.",
      "appre_vocabulary_or_range": "short text",
      "appre_required": false
    },
    "severity": {
      "type": "string",
      "description": "Severity.",
      "appre_vocabulary_or_range": "low|moderate|high|severe|unknown",
      "appre_required": false
    },
    "expected_direction_of_bias": {
      "type": "string",
      "description": "Expected bias direction.",
      "appre_vocabulary_or_range": "improve|worsen|mixed|unknown",
      "appre_required": false
    },
    "affected_domains": {
      "type": "string",
      "description": "Affected domains.",
      "appre_vocabulary_or_range": "semicolon-delimited",
      "appre_required": false
    },
    "requires_exclusion_yes_no": {
      "type": "string",
      "description": "Exclusion flag.",
      "appre_vocabulary_or_range": "yes|no",
      "appre_required": false
    },
    "requires_sensitivity_analysis_yes_no": {
      "type": "string",
      "description": "Sensitivity flag.",
      "appre_vocabulary_or_range": "yes|no",
      "appre_required": false
    },
    "source_of_detection": {
      "type": "string",
      "description": "Source.",
      "appre_vocabulary_or_range": "daily_log|weekly_review|clinician|device|other",
      "appre_required": false
    },
    "entered_by_role": {
      "type": "string",
      "description": "Entered by role.",
      "appre_vocabulary_or_range": "role",
      "appre_required": false
    },
    "reviewed_by_role": {
      "type": "string",
      "description": "Reviewed by role.",
      "appre_vocabulary_or_range": "role",
      "appre_required": false
    },
    "resolution_status": {
      "type": "string",
      "description": "Resolution status.",
      "appre_vocabulary_or_range": "active|resolved|unknown",
      "appre_required": false
    },
    "created_at": {
      "type": "string",
      "description": "Creation timestamp.",
      "appre_vocabulary_or_range": "ISO 8601",
      "appre_required": true
    },
    "record_status": {
      "type": "string",
      "description": "Record status.",
      "appre_vocabulary_or_range": "draft|reviewed|locked|amended",
      "appre_required": true
    }
  },
  "required": [
    "subject_id",
    "confounder_id",
    "confounder_date_start",
    "confounder_category",
    "created_at",
    "record_status"
  ]
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daily Inputs Schema",
  "version": "v0.1.1",
  "description": "APPRE v0.1.1 public schema. Documentation architecture only; not validated AI, CDS, SaMD, or treatment optimization.",
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string",
      "description": "Subject ID.",
      "appre_vocabulary_or_range": "pseudonymous identifier",
      "appre_required": true
    },
    "study_day": {
      "type": "integer",
      "description": "Day number from study start.",
      "appre_vocabulary_or_range": "integer",
      "appre_required": true
    },
    "calendar_date": {
      "type": "string",
      "description": "Date or privacy-shifted date.",
      "appre_vocabulary_or_range": "YYYY-MM-DD or shifted date",
      "appre_required": true
    },
    "phase": {
      "type": "string",
      "description": "Protocol phase.",
      "appre_vocabulary_or_range": "baseline|preload|governed_window|sustain|other",
      "appre_required": true
    },
    "cycle": {
      "type": "string",
      "description": "Protocol cycle.",
      "appre_vocabulary_or_range": "cycle1|cycle2|not_applicable",
      "appre_required": false
    },
    "entry_time": {
      "type": "string",
      "description": "Entry time.",
      "appre_vocabulary_or_range": "HH:MM",
      "appre_required": false
    },
    "entry_mode": {
      "type": "string",
      "description": "Capture mode.",
      "appre_vocabulary_or_range": "paper|spreadsheet|REDCap|ePRO|other",
      "appre_required": false
    },
    "completed_by_role": {
      "type": "string",
      "description": "Reporter role.",
      "appre_vocabulary_or_range": "participant|caregiver|proxy|clinician|assessor|mixed",
      "appre_required": true
    },
    "sleep_hours": {
      "type": "number",
      "description": "Sleep duration.",
      "appre_vocabulary_or_range": "0-24",
      "appre_required": false
    },
    "sleep_quality_0_10": {
      "type": "integer",
      "description": "Sleep quality rating.",
      "appre_vocabulary_or_range": "0-10",
      "appre_required": false
    },
    "wake_time": {
      "type": "string",
      "description": "Wake time.",
      "appre_vocabulary_or_range": "HH:MM",
      "appre_required": false
    },
    "bed_time": {
      "type": "string",
      "description": "Bed time.",
      "appre_vocabulary_or_range": "HH:MM",
      "appre_required": false
    },
    "nap_minutes": {
      "type": "integer",
      "description": "Nap minutes.",
      "appre_vocabulary_or_range": "0-1440",
      "appre_required": false
    },
    "morning_light_yes_no": {
      "type": "string",
      "description": "Morning light exposure.",
      "appre_vocabulary_or_range": "yes|no",
      "appre_required": false
    },
    "morning_light_minutes": {
      "type": "integer",
      "description": "Morning light minutes.",
      "appre_vocabulary_or_range": "0-1440",
      "appre_required": false
    },
    "structured_exertion_yes_no": {
      "type": "string",
      "description": "Structured exertion occurred.",
      "appre_vocabulary_or_range": "yes|no",
      "appre_required": false
    },
    "exertion_minutes": {
      "type": "integer",
      "description": "Exertion minutes.",
      "appre_vocabulary_or_range": "0-1440",
      "appre_required": false
    },
    "steps_count": {
      "type": "integer",
      "description": "Step count if available.",
      "appre_vocabulary_or_range": ">=0",
      "appre_required": false
    },
    "social_contact_yes_no": {
      "type": "string",
      "description": "Meaningful social contact.",
      "appre_vocabulary_or_range": "yes|no",
      "appre_required": false
    },
    "medications_as_prescribed": {
      "type": "string",
      "description": "Medication adherence status.",
      "appre_vocabulary_or_range": "yes|no|unknown",
      "appre_required": false
    },
    "medication_change_yes_no": {
      "type": "string",
      "description": "Medication change flag.",
      "appre_vocabulary_or_range": "yes|no",
      "appre_required": false
    },
    "candidate_input_taken_yes_no": {
      "type": "string",
      "description": "Candidate input taken if defined.",
      "appre_vocabulary_or_range": "yes|no|not_applicable",
      "appre_required": false
    },
    "candidate_input_change_yes_no": {
      "type": "string",
      "description": "Candidate input change flag.",
      "appre_vocabulary_or_range": "yes|no",
      "appre_required": false
    },
    "controlled_substance_as_administered_field_present": {
      "type": "string",
      "description": "If present, observational only.",
      "appre_vocabulary_or_range": "yes|no|not_applicable",
      "appre_required": false
    },
    "breathlessness_0_10": {
      "type": "integer",
      "description": "Breathlessness rating.",
      "appre_vocabulary_or_range": "0-10",
      "appre_required": false
    },
    "spo2_am": {
      "type": "number",
      "description": "Morning SpO2 if available.",
      "appre_vocabulary_or_range": "percent",
      "appre_required": false
    },
    "spo2_pm": {
      "type": "number",
      "description": "Evening SpO2 if available.",
      "appre_vocabulary_or_range": "percent",
      "appre_required": false
    },
    "bp_systolic_am": {
      "type": "integer",
      "description": "Morning systolic BP.",
      "appre_vocabulary_or_range": "mmHg",
      "appre_required": false
    },
    "bp_diastolic_am": {
      "type": "integer",
      "description": "Morning diastolic BP.",
      "appre_vocabulary_or_range": "mmHg",
      "appre_required": false
    },
    "hr_am": {
      "type": "integer",
      "description": "Morning heart rate.",
      "appre_vocabulary_or_range": "bpm",
      "appre_required": false
    },
    "adverse_event_present": {
      "type": "string",
      "description": "AE flag.",
      "appre_vocabulary_or_range": "yes|no",
      "appre_required": false
    },
    "confounder_flag": {
      "type": "string",
      "description": "Confounder flag.",
      "appre_vocabulary_or_range": "yes|no",
      "appre_required": false
    },
    "free_text_note_present": {
      "type": "string",
      "description": "Note present flag without public note content.",
      "appre_vocabulary_or_range": "yes|no",
      "appre_required": false
    },
    "data_absent_reason": {
      "type": "string",
      "description": "Required when expected data missing.",
      "appre_vocabulary_or_range": "controlled vocabulary",
      "appre_required": false
    },
    "created_at": {
      "type": "string",
      "description": "Creation timestamp.",
      "appre_vocabulary_or_range": "ISO 8601",
      "appre_required": true
    },
    "record_status": {
      "type": "string",
      "description": "Record lifecycle status.",
      "appre_vocabulary_or_range": "draft|reviewed|locked|amended",
      "appre_required": true
    }
  },
  "required": [
    "subject_id",
    "study_day",
    "calendar_date",
    "phase",
    "completed_by_role",
    "created_at",
    "record_status"
  ]
}
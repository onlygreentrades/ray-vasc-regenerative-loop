{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Subject Profile Schema",
  "version": "v0.1.1",
  "description": "APPRE v0.1.1 public schema. Documentation architecture only; not validated AI, CDS, SaMD, or treatment optimization.",
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string",
      "description": "Unique subject ID; no direct identifiers.",
      "appre_vocabulary_or_range": "pseudonymous identifier",
      "appre_required": true
    },
    "study_id": {
      "type": "string",
      "description": "Study or protocol identifier.",
      "appre_vocabulary_or_range": "pseudonymous identifier",
      "appre_required": true
    },
    "site_id": {
      "type": "string",
      "description": "Site identifier if multi-site.",
      "appre_vocabulary_or_range": "pseudonymous identifier",
      "appre_required": false
    },
    "consent_status": {
      "type": "string",
      "description": "Consent/LAR status.",
      "appre_vocabulary_or_range": "active|withdrawn|pending|not_applicable",
      "appre_required": true
    },
    "consent_type": {
      "type": "string",
      "description": "Consent pathway.",
      "appre_vocabulary_or_range": "self|LAR|proxy|ethics_waiver|unknown",
      "appre_required": false
    },
    "proxy_available": {
      "type": "string",
      "description": "Whether caregiver/proxy support is available.",
      "appre_vocabulary_or_range": "yes|no",
      "appre_required": true
    },
    "proxy_relationship_category": {
      "type": "string",
      "description": "Broad proxy category only.",
      "appre_vocabulary_or_range": "caregiver|family|clinician|other",
      "appre_required": false
    },
    "age_band": {
      "type": "string",
      "description": "Banded age for privacy.",
      "appre_vocabulary_or_range": "50-59|60-69|70-79|80+",
      "appre_required": false
    },
    "sex_at_birth": {
      "type": "string",
      "description": "Optional demographic field.",
      "appre_vocabulary_or_range": "female|male|intersex|unknown|not_reported",
      "appre_required": false
    },
    "diagnosis_category": {
      "type": "string",
      "description": "Complex neurovascular / mixed phenotype category.",
      "appre_vocabulary_or_range": "controlled vocabulary",
      "appre_required": true
    },
    "phenotype_tags": {
      "type": "string",
      "description": "Phenotype descriptors.",
      "appre_vocabulary_or_range": "semicolon-delimited",
      "appre_required": false
    },
    "baseline_cognitive_status": {
      "type": "string",
      "description": "Baseline cognition descriptor.",
      "appre_vocabulary_or_range": "ordinal/banded",
      "appre_required": false
    },
    "baseline_function_status": {
      "type": "string",
      "description": "Baseline function descriptor.",
      "appre_vocabulary_or_range": "ordinal/banded",
      "appre_required": false
    },
    "care_setting": {
      "type": "string",
      "description": "Implementation setting.",
      "appre_vocabulary_or_range": "home|clinic|assisted_living|memory_care|hybrid|other",
      "appre_required": false
    },
    "caregiver_available_days_per_week": {
      "type": "integer",
      "description": "Caregiver availability estimate.",
      "appre_vocabulary_or_range": "0-7",
      "appre_required": false
    },
    "tier_level": {
      "type": "string",
      "description": "Declared measurement tier.",
      "appre_vocabulary_or_range": "Tier1|Tier2|Tier3",
      "appre_required": true
    },
    "falls_risk_flag": {
      "type": "string",
      "description": "Falls risk flag.",
      "appre_vocabulary_or_range": "yes|no",
      "appre_required": false
    },
    "dysphagia_flag": {
      "type": "string",
      "description": "Swallowing risk flag.",
      "appre_vocabulary_or_range": "yes|no",
      "appre_required": false
    },
    "respiratory_status_flag": {
      "type": "string",
      "description": "Respiratory concern flag.",
      "appre_vocabulary_or_range": "yes|no",
      "appre_required": false
    },
    "sleep_disorder_flag": {
      "type": "string",
      "description": "Sleep disorder concern flag.",
      "appre_vocabulary_or_range": "yes|no",
      "appre_required": false
    },
    "major_safety_flags": {
      "type": "string",
      "description": "Major safety flags.",
      "appre_vocabulary_or_range": "semicolon-delimited",
      "appre_required": false
    },
    "medication_list_hash": {
      "type": "string",
      "description": "Medication list hash or version ID, not raw medication list in public data.",
      "appre_vocabulary_or_range": "hash only",
      "appre_required": false
    },
    "baseline_start_date": {
      "type": "string",
      "description": "Baseline start date or privacy-shifted date.",
      "appre_vocabulary_or_range": "YYYY-MM-DD or shifted date",
      "appre_required": false
    },
    "baseline_end_date": {
      "type": "string",
      "description": "Baseline end date or privacy-shifted date.",
      "appre_vocabulary_or_range": "YYYY-MM-DD or shifted date",
      "appre_required": false
    },
    "created_at": {
      "type": "string",
      "description": "Record creation timestamp.",
      "appre_vocabulary_or_range": "ISO 8601",
      "appre_required": true
    },
    "record_status": {
      "type": "string",
      "description": "Record lifecycle status.",
      "appre_vocabulary_or_range": "draft|reviewed|locked|amended",
      "appre_required": true
    }
  },
  "required": [
    "subject_id",
    "study_id",
    "consent_status",
    "proxy_available",
    "diagnosis_category",
    "tier_level",
    "created_at",
    "record_status"
  ]
}
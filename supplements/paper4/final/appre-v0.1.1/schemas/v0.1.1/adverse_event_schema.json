{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adverse Event Schema",
  "version": "v0.1.1",
  "description": "APPRE v0.1.1 public schema. Documentation architecture only; not validated AI, CDS, SaMD, or treatment optimization.",
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string",
      "description": "Subject ID.",
      "appre_vocabulary_or_range": "pseudonymous identifier",
      "appre_required": true
    },
    "ae_id": {
      "type": "string",
      "description": "AE ID.",
      "appre_vocabulary_or_range": "unique identifier",
      "appre_required": true
    },
    "event_date": {
      "type": "string",
      "description": "Event date.",
      "appre_vocabulary_or_range": "YYYY-MM-DD or shifted date",
      "appre_required": true
    },
    "event_time": {
      "type": "string",
      "description": "Event time.",
      "appre_vocabulary_or_range": "HH:MM",
      "appre_required": false
    },
    "event_category": {
      "type": "string",
      "description": "Event category.",
      "appre_vocabulary_or_range": "fall|respiratory|psychiatric|GI|allergic|cardiovascular|neurologic|swallowing|other",
      "appre_required": true
    },
    "event_description": {
      "type": "string",
      "description": "Structured description; avoid direct identifiers.",
      "appre_vocabulary_or_range": "short text",
      "appre_required": false
    },
    "severity_grade": {
      "type": "string",
      "description": "Severity.",
      "appre_vocabulary_or_range": "mild|moderate|severe|life_threatening|death|unknown",
      "appre_required": true
    },
    "serious_yes_no": {
      "type": "string",
      "description": "Serious flag.",
      "appre_vocabulary_or_range": "yes|no",
      "appre_required": true
    },
    "expected_yes_no": {
      "type": "string",
      "description": "Expectedness.",
      "appre_vocabulary_or_range": "yes|no|unknown",
      "appre_required": false
    },
    "relatedness_assessment": {
      "type": "string",
      "description": "Relatedness.",
      "appre_vocabulary_or_range": "unrelated|unlikely|possible|probable|unknown",
      "appre_required": false
    },
    "suspected_related_input": {
      "type": "string",
      "description": "Suspected input/context.",
      "appre_vocabulary_or_range": "candidate input ID or context",
      "appre_required": false
    },
    "action_taken": {
      "type": "string",
      "description": "Action.",
      "appre_vocabulary_or_range": "continue|pause|simplify|clinician_review|emergency_care|other",
      "appre_required": false
    },
    "clinician_contacted_yes_no": {
      "type": "string",
      "description": "Clinician contacted.",
      "appre_vocabulary_or_range": "yes|no",
      "appre_required": false
    },
    "urgent_care_or_er_yes_no": {
      "type": "string",
      "description": "Urgent/ER care.",
      "appre_vocabulary_or_range": "yes|no",
      "appre_required": false
    },
    "outcome_status": {
      "type": "string",
      "description": "Outcome.",
      "appre_vocabulary_or_range": "ongoing|resolved|resolved_with_sequelae|unknown",
      "appre_required": false
    },
    "resolution_date": {
      "type": "string",
      "description": "Resolution date.",
      "appre_vocabulary_or_range": "YYYY-MM-DD or shifted date",
      "appre_required": false
    },
    "protocol_pause_required_yes_no": {
      "type": "string",
      "description": "Protocol pause flag.",
      "appre_vocabulary_or_range": "yes|no",
      "appre_required": false
    },
    "response_policy_version_triggered": {
      "type": "string",
      "description": "Linked response-policy version.",
      "appre_vocabulary_or_range": "version ID",
      "appre_required": false
    },
    "reported_by_role": {
      "type": "string",
      "description": "Reported by role.",
      "appre_vocabulary_or_range": "role",
      "appre_required": false
    },
    "reviewed_by_role": {
      "type": "string",
      "description": "Reviewed by role.",
      "appre_vocabulary_or_range": "role",
      "appre_required": false
    },
    "created_at": {
      "type": "string",
      "description": "Creation timestamp.",
      "appre_vocabulary_or_range": "ISO 8601",
      "appre_required": true
    },
    "record_status": {
      "type": "string",
      "description": "Record status.",
      "appre_vocabulary_or_range": "draft|reviewed|locked|amended",
      "appre_required": true
    }
  },
  "required": [
    "subject_id",
    "ae_id",
    "event_date",
    "event_category",
    "severity_grade",
    "serious_yes_no",
    "created_at",
    "record_status"
  ]
}
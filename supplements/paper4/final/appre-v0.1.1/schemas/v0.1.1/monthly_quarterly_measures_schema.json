{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Monthly Quarterly Measures Schema",
  "version": "v0.1.1",
  "description": "APPRE v0.1.1 public schema. Documentation architecture only; not validated AI, CDS, SaMD, or treatment optimization.",
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string",
      "description": "Subject ID.",
      "appre_vocabulary_or_range": "pseudonymous identifier",
      "appre_required": true
    },
    "assessment_id": {
      "type": "string",
      "description": "Assessment ID.",
      "appre_vocabulary_or_range": "unique identifier",
      "appre_required": true
    },
    "assessment_date": {
      "type": "string",
      "description": "Assessment date.",
      "appre_vocabulary_or_range": "YYYY-MM-DD or shifted date",
      "appre_required": true
    },
    "study_month": {
      "type": "integer",
      "description": "Study month.",
      "appre_vocabulary_or_range": ">=0",
      "appre_required": false
    },
    "study_quarter": {
      "type": "integer",
      "description": "Study quarter.",
      "appre_vocabulary_or_range": ">=0",
      "appre_required": false
    },
    "phase": {
      "type": "string",
      "description": "Protocol phase.",
      "appre_vocabulary_or_range": "controlled vocabulary",
      "appre_required": true
    },
    "cycle": {
      "type": "string",
      "description": "Cycle.",
      "appre_vocabulary_or_range": "cycle1|cycle2|not_applicable",
      "appre_required": false
    },
    "completed_by_role": {
      "type": "string",
      "description": "Reporter role.",
      "appre_vocabulary_or_range": "participant|caregiver|proxy|clinician|assessor|mixed",
      "appre_required": true
    },
    "moca_total": {
      "type": "integer",
      "description": "MoCA total if used.",
      "appre_vocabulary_or_range": "0-30",
      "appre_required": false
    },
    "trail_making_a_seconds": {
      "type": "number",
      "description": "TMT-A.",
      "appre_vocabulary_or_range": "seconds",
      "appre_required": false
    },
    "trail_making_b_seconds": {
      "type": "number",
      "description": "TMT-B.",
      "appre_vocabulary_or_range": "seconds",
      "appre_required": false
    },
    "verbal_fluency_score": {
      "type": "integer",
      "description": "Verbal fluency.",
      "appre_vocabulary_or_range": ">=0",
      "appre_required": false
    },
    "psqi_total": {
      "type": "integer",
      "description": "PSQI.",
      "appre_vocabulary_or_range": "0-21",
      "appre_required": false
    },
    "cat_total": {
      "type": "integer",
      "description": "CAT.",
      "appre_vocabulary_or_range": "0-40",
      "appre_required": false
    },
    "eat10_total": {
      "type": "integer",
      "description": "EAT-10.",
      "appre_vocabulary_or_range": "0-40",
      "appre_required": false
    },
    "mpsprs15_total": {
      "type": "integer",
      "description": "mPSPRS-15.",
      "appre_vocabulary_or_range": "instrument-specific",
      "appre_required": false
    },
    "mds_updrs_part_iii_total": {
      "type": "integer",
      "description": "MDS-UPDRS III.",
      "appre_vocabulary_or_range": "instrument-specific",
      "appre_required": false
    },
    "six_minute_walk_distance": {
      "type": "number",
      "description": "6MWT.",
      "appre_vocabulary_or_range": "meters",
      "appre_required": false
    },
    "spirometry_fev1": {
      "type": "number",
      "description": "FEV1.",
      "appre_vocabulary_or_range": "liters or percent predicted",
      "appre_required": false
    },
    "spirometry_fvc": {
      "type": "number",
      "description": "FVC.",
      "appre_vocabulary_or_range": "liters or percent predicted",
      "appre_required": false
    },
    "assessment_quality_flag": {
      "type": "string",
      "description": "Quality flag.",
      "appre_vocabulary_or_range": "clean|partial|confounded|missing|uninterpretable",
      "appre_required": false
    },
    "assessor_role": {
      "type": "string",
      "description": "Assessor role.",
      "appre_vocabulary_or_range": "role",
      "appre_required": false
    },
    "same_assessor_as_prior": {
      "type": "string",
      "description": "Measurement comparability.",
      "appre_vocabulary_or_range": "yes|no|unknown",
      "appre_required": false
    },
    "confounder_window_flag": {
      "type": "string",
      "description": "Confounder flag.",
      "appre_vocabulary_or_range": "yes|no",
      "appre_required": false
    },
    "created_at": {
      "type": "string",
      "description": "Creation timestamp.",
      "appre_vocabulary_or_range": "ISO 8601",
      "appre_required": true
    },
    "record_status": {
      "type": "string",
      "description": "Record status.",
      "appre_vocabulary_or_range": "draft|reviewed|locked|amended",
      "appre_required": true
    }
  },
  "required": [
    "subject_id",
    "assessment_id",
    "assessment_date",
    "phase",
    "completed_by_role",
    "created_at",
    "record_status"
  ]
}